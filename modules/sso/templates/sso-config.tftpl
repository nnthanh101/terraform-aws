# ~/.aws/config — IAM Identity Center SSO blocks
# Generated by terraform-aws/modules/sso (sso_cli_config output).
# Paste into ~/.aws/config then run: aws sso login --profile <profile-name>
#
# DO NOT commit this file to version control — it contains your SSO start URL.
# Re-generate at any time: terraform -chdir=<consumer> output -raw sso_cli_config

[sso-session ${sso_session_name}]
sso_start_url = ${sso_start_url}
sso_region = ${sso_region}
sso_registration_scopes = sso:account:access
%{ for a in distinct_assignments ~}

[profile ${sso_session_name}-${a.account_id}-${replace(a.permission_set, " ", "_")}]
sso_session = ${sso_session_name}
sso_account_id = ${a.account_id}
sso_role_name = ${a.permission_set}
region = ${sso_region}
output = json
%{ endfor ~}
